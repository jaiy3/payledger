PORT=4100
DATABASE_URL=postgresql://payledger:payledger@localhost:5433/payledger
# Used by `npm test`. Tests wipe and re-create this database's schema.
DATABASE_URL_TEST=postgresql://payledger:payledger@localhost:5433/payledger_test
# Public URL of this service; used to build the built-in webhook receiver URL.
# On Render, RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=http://localhost:4100
# Run the webhook dispatcher in this process.
WEBHOOK_DISPATCHER=true
